# ==============================================================================
# Dockerfile for Ukraine LWQ xcube Service
# ==============================================================================
# This Dockerfile creates a container with xcube server configured to serve
# the Ukraine Lake Water Quality dataset from Azure Blob Storage.
#
# Build: docker build -f Dockerfile.ukraine -t xcube-ukraine:latest .
# Run:   docker run -p 8080:8080 xcube-ukraine:latest
# ==============================================================================

# Base image with micromamba
ARG MICROMAMBA_VERSION=1.3.1
FROM mambaorg/micromamba:${MICROMAMBA_VERSION}

# User configuration
ARG NEW_MAMBA_USER=xcube
ARG NEW_MAMBA_USER_ID=1000
ARG NEW_MAMBA_USER_GID=1000

# Labels
LABEL maintainer="pabrojast"
LABEL name="xcube-ukraine-lwq"
LABEL description="xcube server for Ukraine Lake Water Quality dataset from Azure Blob Storage"
LABEL version="1.0.0"

# ============================================================================
# System Setup
# ============================================================================
USER root

# Update system and install basic tools
RUN apt-get -y update && \
    apt-get -y upgrade && \
    apt-get -y install vim jq curl wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Configure user
RUN usermod "--login=${NEW_MAMBA_USER}" "--home=/home/${NEW_MAMBA_USER}" \
        --move-home "-u ${NEW_MAMBA_USER_ID}" "${MAMBA_USER}" && \
    groupmod "--new-name=${NEW_MAMBA_USER}" \
             "-g ${NEW_MAMBA_USER_GID}" "${MAMBA_USER}" && \
    echo "${NEW_MAMBA_USER}" > "/etc/arg_mamba_user"

ENV MAMBA_USER=$NEW_MAMBA_USER

# ============================================================================
# Switch to xcube user
# ============================================================================
USER $MAMBA_USER

# Configure micromamba for better network resilience
RUN micromamba config set remote_connect_timeout_secs 30.0 && \
    micromamba config set remote_read_timeout_secs 120.0 && \
    micromamba config set remote_max_retries 5 && \
    micromamba config set remote_backoff_factor 2

# ============================================================================
# Install xcube and dependencies
# ============================================================================

# Copy and install xcube environment
COPY --chown=$MAMBA_USER:$MAMBA_USER environment.yml /tmp/environment.yml
RUN micromamba install -y -n base -f /tmp/environment.yml && \
    micromamba clean --all --yes

# Install Azure Blob Storage support
RUN micromamba install -y -n base -c conda-forge \
    adlfs \
    azure-storage-blob \
    azure-identity \
    fsspec \
    && micromamba clean --all --yes

# Copy xcube source files
COPY --chown=$MAMBA_USER:$MAMBA_USER ./xcube /tmp/xcube
COPY --chown=$MAMBA_USER:$MAMBA_USER ./pyproject.toml /tmp/pyproject.toml
COPY --chown=$MAMBA_USER:$MAMBA_USER ./README.md /tmp/README.md

# Install xcube from source
WORKDIR /tmp
ARG MAMBA_DOCKERFILE_ACTIVATE=1
RUN pip install --no-deps .

# Clean up
RUN micromamba clean --all --force-pkgs-dirs --yes

# ============================================================================
# Setup Ukraine LWQ Service Configuration
# ============================================================================

WORKDIR /home/$MAMBA_USER

# Create service directory
RUN mkdir -p /home/$MAMBA_USER/ukraine_lwq_service

# Copy service configuration files
COPY --chown=$MAMBA_USER:$MAMBA_USER ./xcube_ukraine_config.yml /home/$MAMBA_USER/ukraine_lwq_service/
COPY --chown=$MAMBA_USER:$MAMBA_USER ./ukraine_lwq_viewer.html /home/$MAMBA_USER/ukraine_lwq_service/
COPY --chown=$MAMBA_USER:$MAMBA_USER ./UKRAINE_LWQ_SERVICE.md /home/$MAMBA_USER/ukraine_lwq_service/
COPY --chown=$MAMBA_USER:$MAMBA_USER ./SERVICE_SUMMARY.md /home/$MAMBA_USER/ukraine_lwq_service/

# Set working directory to service
WORKDIR /home/$MAMBA_USER/ukraine_lwq_service

# ============================================================================
# Environment Variables for Azure Storage
# ============================================================================

# Azure Storage credentials (can be overridden at runtime)
ENV AZURE_STORAGE_ACCOUNT_NAME="ihpwinsdata"
ENV AZURE_STORAGE_ACCOUNT_KEY="<AZURE_STORAGE_ACCOUNT_KEY>"
ENV AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=ihpwinsdata;AccountKey=<AZURE_STORAGE_ACCOUNT_KEY>;EndpointSuffix=core.windows.net"

# xcube logging level
ENV XCUBE_LOG_LEVEL="INFO"

# ============================================================================
# Expose port
# ============================================================================

EXPOSE 8080

# ============================================================================
# Health check
# ============================================================================

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/datasets || exit 1

# ============================================================================
# Entrypoint and Default Command
# ============================================================================

# Use micromamba entrypoint
ENTRYPOINT ["/usr/local/bin/_entrypoint.sh"]

# Start xcube server with Ukraine configuration
CMD ["xcube", "serve", \
     "--config", "/home/xcube/ukraine_lwq_service/xcube_ukraine_config.yml", \
     "--address", "0.0.0.0", \
     "--port", "8080", \
     "--verbose"]
